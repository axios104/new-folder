# Copy this file to .env and fill in your values, then:
#   export $(grep -v '^#' .env | xargs)      # Linux/Mac
# or use a tool like python-dotenv / direnv to load it automatically.

# From the Zoho API Console (https://api-console.zoho.com) -> Self Client
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Region-specific domains — MUST match the datacenter your Zoho account is on:
#   India:   accounts.zoho.in      /  www.zohoapis.in
#   US:      accounts.zoho.com     /  www.zohoapis.com
#   EU:      accounts.zoho.eu      /  www.zohoapis.eu
#   AU:      accounts.zoho.com.au  /  www.zohoapis.com.au
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
